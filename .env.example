# copia este archivo como .env y cambia los valores (el .env no se sube a GitHub)

# clave para firmar las sesiones, por ejemplo la salida de:
#   python -c "import secrets; print(secrets.token_hex(32))"
UBITE_SECRET_KEY=

# contraseñas de los usuarios de prueba que crea database/crear_bd.py
UBITE_CLAVE_ADMIN=
UBITE_CLAVE_CAJERO=

# clave para anonimizar a los clientes en el almacén y en los datasets (hash HMAC del celular)
UBITE_CLAVE_ANONIMA=

# correo de contacto que se envia con las notificaciones push
UBITE_CONTACTO=mailto:cafeteria@ubite.local

# dirección del servicio de IA (carpeta ia/) que usa la pantalla de alertas de reposición
UBITE_IA_URL=http://127.0.0.1:8000

# opcional: otra ruta para la base de datos
# UBITE_DB=database/ubite.db 
