	partition Pedidos = m
		mode: import
		source =
				let
				    Fuente = Odbc.Query(Conexion, "SELECT id_pedido, id_fecha, id_franja, origen, estado_final, min_cola_a_listo, min_listo_a_entrega, total FROM hecho_pedido"),
				    Tipos = Table.TransformColumnTypes(Fuente, {{"id_pedido", Int64.Type}, {"id_fecha", Int64.Type}, {"id_franja", Int64.Type}, {"origen", type text}, {"estado_final", type text}, {"min_cola_a_listo", type number}, {"min_listo_a_entrega", type number}, {"total", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

