table Pedidos
	lineageTag: 6d267c99-6648-a8c8-ff4f-20557de7f6df

	measure Pedidos = COUNTROWS ( Pedidos )
		formatString: #,0
		lineageTag: cc4ebfdf-1c64-5598-7a2c-649058a0fd70

	measure 'Pedidos entregados' = CALCULATE ( [Pedidos], Pedidos[estado_final] = "entregado" )
		formatString: #,0
		lineageTag: 0c1b272f-5df2-24c7-7ecc-687c44d6cf67

	measure '% cancelados' = DIVIDE ( CALCULATE ( [Pedidos], Pedidos[estado_final] = "cancelado" ), [Pedidos] )
		formatString: 0.0%
		lineageTag: 30572f32-bc2d-5f94-b7e5-6eb4c54cc165

	measure '% por QR' = DIVIDE ( CALCULATE ( [Pedidos], Pedidos[origen] = "qr" ), [Pedidos] )
		formatString: 0.0%
		lineageTag: 6e9cb51c-812e-e8f3-3b2b-e6dbc4bdabfd

	measure 'Ticket promedio' = DIVIDE ( [Ventas], [Pedidos entregados] )
		formatString: \$ #,0
		lineageTag: 45761ecf-901c-111e-194e-a89c3f841b8f

