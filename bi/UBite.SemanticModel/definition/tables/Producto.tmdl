	partition Producto = m
		mode: import
		source =
				let
				    Fuente = Odbc.Query(Conexion, "SELECT id_producto, nombre, categoria, precio_actual, activo FROM dim_producto"),
				    Tipos = Table.TransformColumnTypes(Fuente, {{"id_producto", Int64.Type}, {"nombre", type text}, {"categoria", type text}, {"precio_actual", type number}, {"activo", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

