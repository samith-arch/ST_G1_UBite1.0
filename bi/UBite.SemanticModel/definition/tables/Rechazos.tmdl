table Rechazos
	lineageTag: b581aace-ca16-9a4d-7fab-b8fbc1317bc1

	measure 'Intentos rechazados' = SUM ( Rechazos[cantidad] )
		formatString: #,0
		lineageTag: 4b03e52f-d22d-cf6c-0ae1-6b9bcd8d477a

	measure 'Rechazos por stock' = CALCULATE ( [Intentos rechazados], Rechazos[motivo] = "Sin stock suficiente" )
		formatString: #,0
		lineageTag: 8f69634c-d5c1-1f0f-abdb-02d08ab455a5

	column id_fecha
		dataType: int64
		isHidden
		lineageTag: 045847af-44b1-31d1-8016-972eb0e5d21c
		summarizeBy: none
		sourceColumn: id_fecha

		annotation SummarizationSetBy = Automatic

	column id_franja
		dataType: int64
		isHidden
		lineageTag: 6f95fc48-e6df-8d20-cf43-5571ec73e38d
		summarizeBy: none
		sourceColumn: id_franja

		annotation SummarizationSetBy = Automatic

	column operacion
		dataType: string
		lineageTag: a4bdef32-b6c2-2d0a-0dcd-13fc3b6686be
		summarizeBy: none
		sourceColumn: operacion

		annotation SummarizationSetBy = Automatic

	column motivo
		dataType: string
		lineageTag: 19e19b05-62e2-3a09-1f2a-8cd3477b6ac5
		summarizeBy: none
		sourceColumn: motivo

		annotation SummarizationSetBy = Automatic

	column origen
		dataType: string
		lineageTag: 7684ba43-9f1b-1110-92bb-1729c38ed0b3
		summarizeBy: none
		sourceColumn: origen

		annotation SummarizationSetBy = Automatic

	column cantidad
		dataType: int64
		lineageTag: f200d735-af09-4db4-9d80-7e0f24753383
		summarizeBy: sum
		sourceColumn: cantidad

		annotation SummarizationSetBy = Automatic

	partition Rechazos = m
		mode: import
		source =
				let
				    Fuente = Odbc.Query(Conexion, "SELECT id_fecha, id_franja, operacion, motivo, origen, cantidad FROM hecho_rechazo"),
				    Tipos = Table.TransformColumnTypes(Fuente, {{"id_fecha", Int64.Type}, {"id_franja", Int64.Type}, {"operacion", type text}, {"motivo", type text}, {"origen", type text}, {"cantidad", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

