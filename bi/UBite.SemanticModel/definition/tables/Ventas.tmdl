table Ventas
	lineageTag: adcc3032-7981-bffd-4f2f-27d482e52e78

	measure Ventas = SUM ( Ventas[valor] )
		formatString: \$ #,0
		lineageTag: 77feb299-221c-c42d-22bf-eaec2c426466

	measure 'Unidades vendidas' = SUM ( Ventas[cantidad] )
		formatString: #,0
		lineageTag: db5cdc04-a14b-894d-d2dd-068781173f17

	column id_pedido
		dataType: int64
		isHidden
