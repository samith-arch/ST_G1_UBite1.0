		sourceColumn: valor

		annotation SummarizationSetBy = Automatic

	partition Ventas = m
		mode: import
		source =
				let
				    Fuente = Odbc.Query(Conexion, "SELECT id_pedido, id_fecha, id_franja, id_producto, origen, cantidad, valor FROM hecho_venta"),
				    Tipos = Table.TransformColumnTypes(Fuente, {{"id_pedido", Int64.Type}, {"id_fecha", Int64.Type}, {"id_franja", Int64.Type}, {"id_producto", Int64.Type}, {"origen", type text}, {"cantidad", Int64.Type}, {"valor", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

